{
    "name": "monorepo",
    "private": true,
    "scripts": {
        "cli": "pnpm --filter happy exec tsx src/index.ts",
        "release": "node ./scripts/release.cjs",
        "web": "pnpm --filter happy-app web",
        "codium": "pnpm --filter codium dev",
        "app-logs": "pnpm --filter happy-app-logs start",
        "postinstall": "node ./scripts/postinstall.cjs",
        "env:new": "tsx environments/environments.ts new",
        "env:list": "tsx environments/environments.ts list",
        "env:use": "tsx environments/environments.ts use",
        "env:remove": "tsx environments/environments.ts remove",
        "env:current": "tsx environments/environments.ts current",
        "env:server": "tsx environments/environments.ts run server",
        "env:web": "tsx environments/environments.ts run web",
        "env:ios": "tsx environments/environments.ts run ios",
        "env:android": "tsx environments/environments.ts run android",
        "env:cli": "tsx environments/environments.ts run cli",
        "env:seed": "tsx environments/environments.ts seed",
        "env:up": "tsx environments/environments.ts up",
        "env:up:authenticated": "pnpm env:up --template authenticated-empty",
        "env:down": "tsx environments/environments.ts down",
        "env:tailscale": "tsx environments/environments.ts tailscale",
        "docs:sync": "node ./scripts/docs/knowledge-base.mjs --write",
        "docs:check": "node ./scripts/docs/knowledge-base.mjs --check"
    },
    "workspaces": {
        "packages": [
            "packages/happy-app",
            "packages/happy-agent",
            "packages/happy-cli",
            "packages/happy-server",
            "packages/happy-wire",
            "packages/happy-app-logs",
            "packages/codium"
        ]
    },
    "pnpm": {
        "overrides": {
            "@babel/core@7": "7.29.6",
            "@hono/node-server": "1.19.17",
            "whatwg-url": "14.2.0",
            "ajv@6": "6.15.0",
            "ajv@8": "8.20.0",
            "basic-ftp": "5.3.1",
            "body-parser": "2.3.0",
            "parse-path": "7.0.3",
            "@types/parse-path": "7.0.3",
            "@xmldom/xmldom": "0.8.13",
            "brace-expansion@1": "1.1.18",
            "brace-expansion@2": "2.1.4",
            "brace-expansion@5": "5.0.9",
            "defu": "6.1.7",
            "effect": "3.20.0",
            "engine.io": "6.6.9",
            "engine.io-client": "6.6.6",
            "dompurify": "3.4.13",
            "fast-xml-parser": "5.10.1",
            "fast-uri": "3.1.5",
            "flatted": "3.4.2",
            "follow-redirects": "1.16.0",
            "form-data": "4.0.6",
            "hono": "4.13.2",
            "ip-address": "10.3.1",
            "js-yaml@3": "3.15.1",
            "js-yaml@4": "4.3.1",
            "lodash": "4.18.1",
            "lodash-es": "4.18.1",
            "minimatch@3": "3.1.4",
            "mermaid": "11.16.1",
            "nanoid@3": "3.3.18",
            "node-forge": "1.4.0",
            "picomatch@2": "2.3.2",
            "postcss@8": "8.5.26",
            "prismjs": "1.30.0",
            "path-to-regexp": "8.4.0",
            "qs": "6.15.3",
            "rollup@4": "4.59.0",
            "shell-quote": "1.10.0",
            "socket.io-parser": "4.2.7",
            "tar@7": "7.5.22",
            "tmp": "0.2.7",
            "undici@6": "6.28.0",
            "uuid@11": "11.1.1",
            "@vitest/mocker@3>vite": "7.3.5",
            "vite-node@3>vite": "7.3.5",
            "vite-tsconfig-paths@5>vite": "8.0.16",
            "vitest@3>vite": "7.3.5",
            "ws@7": "7.5.11",
            "yaml@1": "1.10.3",
            "yaml@2": "2.9.0"
        },
        "onlyBuiltDependencies": [
            "@more-tech/react-native-libsodium",
            "@prisma/client",
            "@prisma/engines",
            "@shopify/react-native-skia",
            "@tailwindcss/oxide",
            "better-sqlite3",
            "electron",
            "esbuild",
            "node-pty",
            "prisma",
            "sharp"
        ]
    },
    "packageManager": "pnpm@10.11.0"
}
